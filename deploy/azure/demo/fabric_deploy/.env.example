# =============================================================================
# Kronos-on-Fabric demo — deployment config
# Copy to `.env` (gitignored) and fill in. NON-SECRET values only.
#
# Auth is handled by azure-identity's DefaultAzureCredential — DO NOT put a
# client secret here unless you have no alternative (see AUTH section below).
# =============================================================================

# --- Fabric target -----------------------------------------------------------
# A Fabric capacity (F-SKU or Trial) is REQUIRED to create a workspace. If you
# already have a workspace with capacity, set FABRIC_WORKSPACE_ID and leave
# FABRIC_CAPACITY_ID blank — the script will reuse it.
FABRIC_WORKSPACE_NAME=kronos-rti-demo
FABRIC_WORKSPACE_ID=
FABRIC_CAPACITY_ID=

# Eventhouse + KQL database to create (or reuse if they already exist).
EVENTHOUSE_NAME=kronos-eventhouse
KQL_DATABASE_NAME=kronos_rt

# --- Demo parameters (optional; sensible defaults if omitted) -----------------
DEMO_SYMBOL=BTCUSDT
DEMO_LOOKBACK=120
DEMO_PRED_LEN=30
DEMO_STRIDE=3
# Replaying every raw tick is ~700 KB of commands; false is faster and still
# rebuilds candles from a representative load in most demos.
EMIT_TICKS=true

# --- Auth (choose ONE) -------------------------------------------------------
# 1) INTERACTIVE (recommended for a laptop): leave everything below blank and
#    the script uses device-code / browser login via DefaultAzureCredential.
#
# 2) SERVICE PRINCIPAL for CI: set these as ENVIRONMENT VARIABLES in your
#    pipeline's secret store (NOT in this file). DefaultAzureCredential picks
#    them up automatically:
#       AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
#    The SP needs: Fabric workspace Admin/Member + rights on the capacity, and
#    (for KQL) Database Admin on the KQL database.
#
# 3) LAST RESORT plaintext SP secret in this file (opt-in, insecure). Only if
#    you accept the risk; keep .env gitignored.
# FABRIC_SP_TENANT_ID=
# FABRIC_SP_CLIENT_ID=
# FABRIC_SP_CLIENT_SECRET=
